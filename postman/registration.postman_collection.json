{
  "info": {
    "name": "KanMind registration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Registration contract and validation checks. Run against a local test database; each run creates four test accounts."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8001"
    }
  ],
  "item": [
    {
      "name": "Create account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/registration/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullname\": \"Registration Test\",\n  \"email\": \"{{registration_email}}\",\n  \"password\": \"School-test-284!\",\n  \"repeated_password\": \"School-test-284!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"registration_email\", \"kanmind-\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.com\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const responseData = pm.response.json();",
              "pm.test(\"Exact response fields\", () => pm.expect(Object.keys(responseData).sort()).to.eql([\"email\", \"fullname\", \"token\", \"user_id\"]));",
              "pm.test(\"Token and user ID\", () => { pm.expect(responseData.token).to.match(/^[a-f0-9]{40}$/); pm.expect(responseData.user_id).to.be.a(\"number\").above(0); });",
              "const sent = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
              "pm.test(\"Name and normalized email\", () => { pm.expect(responseData.fullname).to.eql(sent.fullname.trim()); pm.expect(responseData.email).to.eql(sent.email.trim().toLowerCase()); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Duplicate email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/registration/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullname\": \"Registration Test\",\n  \"email\": \"{{registration_email}}\",\n  \"password\": \"School-test-284!\",\n  \"repeated_password\": \"School-test-284!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"No credentials in error response\", () => { const responseData = pm.response.json(); pm.expect(responseData).not.to.have.property(\"token\"); pm.expect(responseData).not.to.have.property(\"user_id\"); });",
              "pm.test(\"Field error\", () => pm.expect(pm.response.json()).to.have.property(\"email\"));"
            ]
          }
        }
      ]
    },
